rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Tournaments Collection - Publicly accessible for match browsing, joining, and admin
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }

    // Deposit Requests Collection (UTR Verification)
    match /deposit_requests/{depositId} {
      allow read, write: if true;
    }

    // Withdrawal Requests Collection
    match /withdrawal_requests/{withdrawalId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // System / Connection Test Collection
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
